#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const path = require('node:path');

function linuxPath(value) {
  const match = value.match(/^([a-z]):[\\/](.*)$/i);
  if (!match) throw new Error(`not a Windows path: ${value}`);
  return path.join(process.env.WC_FAKE_MOUNT, match[1].toLowerCase(), ...match[2].split(/[\\/]/));
}

const index = process.argv.indexOf('-EncodedCommand');
const script = Buffer.from(process.argv[index + 1], 'base64').toString('utf16le');
const match = script.match(/^# wc:([a-z]+) ([A-Za-z0-9+/=]+)\r?\n/);
if (!match) {
  process.stderr.write('missing operation header\n');
  process.exit(1);
}
const args = JSON.parse(Buffer.from(match[2], 'base64').toString());
switch (match[1]) {
  case 'appwrap': {
    const settings = JSON.parse(args.argv[0] || '{}');
    const dir = process.env.WC_FAKE_APP_DIR;
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(path.join(dir, args.id + '.json'), JSON.stringify({ pid: process.pid, args, settings }));
    fs.mkdirSync(path.dirname(linuxPath(args.log)), { recursive: true });
    fs.writeFileSync(linuxPath(args.log), settings.output || 'x'.repeat(settings.outputBytes || 0));
    if (settings.echoEnv) fs.appendFileSync(linuxPath(args.log), JSON.stringify({ wrapper: process.env.WHEELCHAIR_SESSION_TOKEN || null, program: Object.fromEntries(args.env).WHEELCHAIR_SESSION_TOKEN || null }));
    console.log(JSON.stringify({ started: { pid: process.pid + 10000, created: '133000000000000001', wrapper_pid: process.pid, wrapper_created: '133000000000000002' } }));
    setTimeout(() => { if (!settings.noDone) console.log(JSON.stringify({ done: { exit_code: settings.exitCode || 0 } })); }, settings.duration ?? 50);
    break;
  }
  case 'appwindows': {
    const windows = [];
    for (const app of args.apps) {
      try {
        const record = JSON.parse(fs.readFileSync(path.join(process.env.WC_FAKE_APP_DIR, app.id + '.json')));
        for (const window of record.settings.windows || []) windows.push({ ...window, pid: record.pid + 10000, app_id: app.id });
      } catch (e) { if (e.code !== 'ENOENT') throw e; }
    }
    console.log(JSON.stringify(windows));
    break;
  }
  case 'appshot':
    fs.writeFileSync(linuxPath(args.destination), 'fake png');
    break;
  case 'appterminate': {
    const file = path.join(process.env.WC_FAKE_APP_DIR, args.id + '.json');
    try { const record = JSON.parse(fs.readFileSync(file)); process.kill(record.pid, 'SIGKILL'); } catch (e) { if (e.code !== 'ENOENT' && e.code !== 'ESRCH') throw e; }
    break;
  }
  case 'localappdata':
    console.log(process.env.WC_FAKE_LOCALAPPDATA);
    break;
  case 'gitpath':
    console.log(process.env.WC_FAKE_GIT_PATH || '');
    break;
  case 'seed':
    for (const relative of args.paths) {
      const source = path.join(linuxPath(args.source), relative);
      const destination = path.join(linuxPath(args.destination), relative);
      fs.mkdirSync(path.dirname(destination), { recursive: true });
      fs.copyFileSync(source, destination);
    }
    break;
  default:
    process.stderr.write(`unknown operation ${match[1]}\n`);
    process.exit(1);
}
