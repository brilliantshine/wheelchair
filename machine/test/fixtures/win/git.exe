#!/usr/bin/env node
'use strict';
const path = require('node:path');
const fs = require('node:fs');
const { spawnSync } = require('node:child_process');
const mount = process.env.WC_FAKE_MOUNT;
function translate(s) { return s.replace(/([A-Za-z]):\\([^\0]*)/g, (_, drive, rest) => path.join(mount, drive.toLowerCase(), ...rest.split('\\'))); }
const args = process.argv.slice(2).map(translate);
const env = Object.fromEntries(Object.entries(process.env).map(([k,v]) => [k,translate(v)]));
const fault = process.env.WC_FAKE_GIT_FAIL_ONCE;
if (fault && args.includes(fault) && process.env.WC_FAKE_GIT_FAULT_FILE && !fs.existsSync(process.env.WC_FAKE_GIT_FAULT_FILE)) { fs.writeFileSync(process.env.WC_FAKE_GIT_FAULT_FILE,'failed'); process.stderr.write(`injected ${fault} failure\n`); process.exit(1); }
const result = spawnSync('git', args, { env, stdio:'inherit' }); process.exit(result.status === null ? 1 : result.status);
